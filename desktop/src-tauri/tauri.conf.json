{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "20-below-desktop",
  "version": "0.1.0",
  "identifier": "com.feralucce.twentybelow",
  "build": {
    "frontendDist": "../../"
  },
  "app": {
    "windows": [
      {
        "title": "20 Below",
        "url": "app/index.html",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
