#!/bin/sh
# Stop a rules change going out with a stale book, and stop an app going
# out disagreeing with itself about its own version.
#
# The webbook is generated from the Scrivener manuscript with tables merged
# out of rules/*.md. Nothing watches either one, so a rules commit can ship
# while webbook/ still says the old thing - which is exactly what happened
# on 2026-09-09: the Gifts chapter taught fixed damage dice for a day after
# the rules changed, and every build in between reported normal counts.
#
# Fires only when a commit touches something the book is built from. Runs
# the build, and refuses the commit if that produces webbook/ changes you
# have not staged. The rebuild is left in the working tree, so the fix is
# always "git add webbook/ and commit again".
#
# Install:  git config core.hooksPath tools/hooks
# Skip once: git commit --no-verify

staged=$(git diff --cached --name-only)

# A version bump that lands only in tauri.conf.json leaves Cargo.toml
# behind, and nothing downstream complains - the Creator's crate version
# fell four releases behind that way before anyone looked. Checked at the
# commit because that is where the two files part company; by release
# time the bundle is already built.
if echo "$staged" | grep -qE '/src-tauri/(tauri\.conf\.json|Cargo\.(toml|lock))$'; then
  if ! out=$(python tools/check-desktop-drift.py --versions 2>&1); then
    echo "$out"
    echo
    echo "pre-commit: an app disagrees with itself about its own version."
    echo "  tauri.conf.json is what the installer and Windows report, so"
    echo "  bring Cargo.toml and Cargo.lock up to it and commit again."
    exit 1
  fi
  echo "pre-commit: app versions agree with themselves."
fi

echo "$staged" | grep -qE '^(rules/.*\.(md|json)|tools/(scriv2(web|brew)|extract-flavour)\.py)$' || exit 0

# rules/flavour.json is generated from the print chapters, so a prose edit
# there reaches the app only if it has been regenerated. Checked before the
# webbook build because it is quick and its failure is easier to read.
if ! out=$(python tools/extract-flavour.py --check 2>&1); then
  echo "$out"
  echo
  echo "pre-commit: rules/flavour.json is stale or disagrees with the"
  echo "  rules tables. Committing now would ship the app descriptions"
  echo "  that no longer match the book."
  exit 1
fi

echo "pre-commit: rules or builder changed, rebuilding the webbook..."

if ! out=$(python tools/scriv2web.py 2>&1); then
  echo "$out"
  echo
  echo "pre-commit: the build FAILED, so the book cannot be checked."
  echo "  If Scrivener is open it may be holding the project file."
  echo "  Close it and commit again, or use --no-verify if you know better."
  exit 1
fi

# HOLLOW lines are the build's own report of a transform that ran and boxed
# nothing. They do not fail the build, which is the point of surfacing them.
if echo "$out" | grep -q HOLLOW; then
  echo
  echo "$out" | grep HOLLOW
  echo
  echo "pre-commit: the build reported HOLLOW findings. Read them before"
  echo "  committing - each one is content that silently did not make it."
  exit 1
fi

drifted=$(git diff --name-only -- webbook/)
if [ -n "$drifted" ]; then
  echo
  echo "pre-commit: the rebuild changed the book, and those changes are not"
  echo "  staged. Committing now would publish a stale webbook."
  echo
  echo "$drifted" | sed 's/^/    /'
  echo
  echo "  The rebuild is already in your working tree. To go ahead:"
  echo "      git add webbook/ && git commit"
  exit 1
fi

echo "pre-commit: book is current."
exit 0
